generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int           @id @default(autoincrement())
  name        String
  title       String
  description String
  email       String?
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  location    String?
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  category  String
  sortOrder Int     @default(0)
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id           Int           @id @default(autoincrement())
  company      String
  position     String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  stack        String?
  sortOrder    Int           @default(0)
  profileId    Int
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@index([profileId])
}

model Achievement {
  id           Int        @id @default(autoincrement())
  text         String
  sortOrder    Int        @default(0)
  experienceId Int
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Project {
  id            Int     @id @default(autoincrement())
  name          String
  url           String
  repositoryUrl String?
  description   String
  stack         String?
  sortOrder     Int     @default(0)
  profileId     Int
  profile       Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
